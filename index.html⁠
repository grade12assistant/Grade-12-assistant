        const motivationalQuotes = [
            "« بەردەوامبە، ئەو ڕێگایەی ئەمڕۆ لێی ماندوویت، بەیانی دەتگەیەنێتە ئەو لوتکەیەی خەونت پێوە دەبینی. »",
            "« تۆ تەنها یەک هەنگاو لە بەدیهاتنی خەونەکانت دووریت، کۆڵ مەدە. »",
            "« سەرکەوتن بەخت نییە، بەڵکو بەرهەمی ماندووبوون و شەونخونییەکانی تۆیە. »",
            "« هەموو کاتژمێرێک کە ئێستا دەیخوێنیت، سەرمایەیەکە بۆ ئایندە پڕ لە شانازییەکەت. »",
            "« کاتێک هەست بە ماندووبوون دەکەیت، بیر لەو ڕۆژە بکەرەوە کە نمرەکەت وەردەگریتەوە و خێزانەکەت پێی دڵخۆش دەبن. »",
            "« بڕوات بە خۆت هەبێت؛ تۆ زۆر لەوە بەهێزتریت کە خۆت بیری لێ دەکەیتەوە. »",
            "« سەرکەوتن لە کۆتایی ڕێگای کۆڵنەدان دێت، کەواتە بڕۆ پێشەوە! »",
            "« ئەمڕۆ بخوێنە بۆ ئەوەی بەیانی بەو شێوەیە بژیت کە ئارەزووی دەکەیت. »",
            "« ڕۆژە سەختەکان دەڕۆن، بەڵام مرۆڤە بەهێزەکان دەمێننەوە و سەردەکەون. »",
            "« هیچ شتێک مەحاڵ نییە بۆ کەسێک کە ئیرادەی هەبێت. »"
        ];

        let currentStream = 'scientific';
        let selectedSubject = subjectsData.scientific[0];
        let currentQuoteIndex = 0;

        const landingScreen = document.getElementById('landing-screen');
        const enterWebsiteBtn = document.getElementById('enter-website-btn');
        const subjectsContainer = document.getElementById('subjects-container');
        const materialsContainer = document.getElementById('materials-container');
        const materialsTitle = document.getElementById('materials-title');
        const quoteDisplay = document.getElementById('quote-display');
        const quoteDayCount = document.getElementById('quote-day-count');
        const btnNextQuote = document.getElementById('btn-next-quote');

        enterWebsiteBtn.onclick = () => {
            landingScreen.style.opacity = '0';
            setTimeout(() => {
                landingScreen.style.display = 'none';
            }, 400);
        };

        function updateDailyQuote() {
            const now = new Date();
            const start = new Date(now.getFullYear(), 0, 0);
            const diff = now - start;
            const oneDay = 1000 * 60 * 60 * 24;
            const dayOfYear = Math.floor(diff / oneDay);
            currentQuoteIndex = dayOfYear % motivationalQuotes.length;
            renderQuote();
        }

        function renderQuote() {
            quoteDayCount.innerText = `هاندان بۆ سەرکەوتن (ڕۆژی ${currentQuoteIndex + 1})`;
            quoteDisplay.innerText = motivationalQuotes[currentQuoteIndex];
        }

        btnNextQuote.onclick = () => {
            currentQuoteIndex = (currentQuoteIndex + 1) % motivationalQuotes.length;
            renderQuote();
        };

        function renderSubjects() {
            subjectsContainer.innerHTML = subjectsData[currentStream].map(sub => `
                <div class="subject-card ${sub.id === selectedSubject.id ? 'active' : ''}" onclick="selectSubject('${sub.id}')">
                    <span class="subject-emoji">${sub.icon}</span>
                    <h4>${sub.name}</h4>
                </div>
            `).join('');
            renderMaterials();
        }

        window.selectSubject = (id) => {
            const list = subjectsData[currentStream];
            selectedSubject = list.find(s => s.id === id);
            renderSubjects();
        };

        function renderMaterials() {
            materialsTitle.innerText = `سەرچاوەکانی وانەی (${selectedSubject.name})`;

            let targetMaterials = selectedSubject.materials;
            if (selectedSubject.sharedFrom) {
                const found = subjectsData.scientific.find(s => s.id === selectedSubject.sharedFrom);
                if (found) targetMaterials = found.materials;
            }

            if (selectedSubject.underDev) {
                materialsContainer.innerHTML = `
                    <div class="under-dev-box">
                        <div style="font-size: 2.2rem; margin-bottom: 8px;">⚠️</div>
                        <h4 style="font-size: 1.05rem; font-weight: 800; margin-bottom: 6px;">بەداخەوە ئەم بەشە کاری تێ دەکرێت</h4>
                        <p style="font-size: 0.85rem; color: #FCA5A5;">هێشتا لەلایەن سەرۆکەوە تەواو نەکراوە</p>
                    </div>
                `;
                return;
            }

            if (targetMaterials && targetMaterials.length > 0) {
                materialsContainer.innerHTML = `
                    <div class="materials-grid">
                        ${targetMaterials.map(m => `
                            <a href="${m.link}" target="_blank" class="material-link-card">
                                <div style="display: flex; align-items: center; gap: 12px;">
                                    <div class="mat-badge-icon" style="background: ${m.color};">
                                        ${m.icon}
                                    </div>
                                    <div>
                                        <div style="font-weight: 800; font-size: 0.92rem;">${m.title}</div>
                                        <div style="font-size: 0.75rem; color: var(--text-secondary);">${m.sub}</div>
                                    </div>
                                </div>
                                <span style="color: var(--text-secondary);">‹</span>
                            </a>
                        `).join('')}
                    </div>
                `;
            }
        }

        document.querySelectorAll('.switcher-tab').forEach(tab => {
            tab.onclick = () => {
                document.querySelector('.switcher-tab.active').classList.remove('active');
                tab.classList.add('active');
                currentStream = tab.dataset.stream;
                selectedSubject = subjectsData[currentStream][0];
                renderSubjects();
            };
        });

        updateDailyQuote();
        renderSubjects();
    </script>
