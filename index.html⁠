<!DOCTYPE html>
<html lang="ckb" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Grade 12 Assistant | یاریدەدەری پۆلی ١٢</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary: #6366F1;
            --primary-glow: rgba(99, 102, 241, 0.35);
            --accent-pink: #EC4899;
            --bg-main: #070A14;
            --card-surface: rgba(18, 24, 43, 0.85);
            --card-border: rgba(255, 255, 255, 0.08);
            --text-primary: #F9FAFB;
            --text-secondary: #94A3B8;
            --radius-xl: 24px;
            --radius-lg: 18px;
            --radius-md: 14px;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Vazirmatn', sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background-color: var(--bg-main);
            color: var(--text-primary);
            min-height: 100vh;
            overflow-x: hidden;
            position: relative;
        }

        .ambient-blob {
            position: fixed;
            width: 450px;
            height: 450px;
            border-radius: 50%;
            filter: blur(140px);
            z-index: 0;
            pointer-events: none;
            opacity: 0.35;
        }
        .blob-1 { top: -100px; right: -60px; background: #4F46E5; }
        .blob-2 { bottom: -100px; left: -60px; background: #EC4899; }

        /* Welcome Screen */
        #landing-screen {
            position: fixed;
            inset: 0;
            background: rgba(7, 10, 20, 0.97);
            backdrop-filter: blur(25px);
            z-index: 10000;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            transition: opacity 0.4s ease, visibility 0.4s ease;
        }

        .welcome-card {
            background: var(--card-surface);
            border: 1px solid var(--card-border);
            padding: 34px 22px;
            border-radius: var(--radius-xl);
            max-width: 460px;
            width: 100%;
            text-align: center;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.85);
        }

        .btn-enter {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            width: 100%;
            padding: 14px;
            background: linear-gradient(135deg, var(--primary), #818CF8);
            color: #FFFFFF;
            font-size: 1.05rem;
            font-weight: 800;
            border: none;
            border-radius: var(--radius-md);
            cursor: pointer;
            box-shadow: 0 10px 25px var(--primary-glow);
            transition: all 0.25s ease;
            margin-top: 22px;
        }
        .btn-enter:hover {
            transform: translateY(-2px);
        }

        /* Container */
        .app-container {
            max-width: 920px;
            margin: 0 auto;
            padding: 24px 16px 80px 16px;
            position: relative;
            z-index: 2;
        }

        /* Hub Top Cards */
        .top-hub-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 12px;
            margin-bottom: 22px;
        }

        .hub-card {
            background: var(--card-surface);
            border: 1px solid var(--card-border);
            border-radius: var(--radius-lg);
            padding: 16px 18px;
            text-decoration: none;
            color: var(--text-primary);
            display: flex;
            align-items: center;
            justify-content: space-between;
            backdrop-filter: blur(14px);
            transition: all 0.25s ease;
        }
        .hub-card:hover {
            border-color: var(--primary);
            transform: translateY(-2px);
        }

        .hub-inner {
            display: flex;
            align-items: center;
            gap: 14px;
        }
        .hub-icon-wrap {
            width: 44px;
            height: 44px;
            border-radius: var(--radius-md);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
        }

        /* Telegram Box */
        .tele-multi-box {
            background: var(--card-surface);
            border: 1px solid var(--card-border);
            border-radius: var(--radius-lg);
            padding: 16px 18px;
            backdrop-filter: blur(14px);
        }
        .tele-multi-header {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 12px;
            font-size: 0.95rem;
            font-weight: 800;
            color: #38BDF8;
        }
        .tele-actions-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }
        .tele-sub-btn {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid var(--card-border);
            padding: 12px;
            border-radius: var(--radius-md);
            text-decoration: none;
            color: var(--text-primary);
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.82rem;
            font-weight: 600;
            transition: all 0.2s ease;
        }
        .tele-sub-btn:hover {
            background: rgba(56, 189, 248, 0.15);
            border-color: #38BDF8;
        }

        /* Motivational Quote Box */
        .daily-quote-card {
            background: linear-gradient(135deg, rgba(236, 72, 153, 0.1), rgba(99, 102, 241, 0.1));
            border: 1px solid rgba(236, 72, 153, 0.25);
            border-radius: var(--radius-lg);
            padding: 18px;
            margin-bottom: 22px;
        }
        .quote-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 10px;
            background: rgba(236, 72, 153, 0.2);
            color: #F472B6;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 800;
            margin-bottom: 10px;
        }
        .quote-text {
            font-size: 0.95rem;
            font-weight: 600;
            line-height: 1.7;
            color: #FDF2F8;
            margin-bottom: 12px;
        }

        /* Special Links */
        .special-cards-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-bottom: 22px;
        }
        .special-btn-card {
            background: var(--card-surface);
            border: 1px solid var(--card-border);
            border-radius: var(--radius-lg);
            padding: 15px;
            text-decoration: none;
            color: var(--text-primary);
            display: flex;
            align-items: center;
            gap: 12px;
            transition: all 0.25s ease;
        }
        .special-btn-card:hover {
            border-color: var(--accent-pink);
            transform: translateY(-2px);
        }

        /* Stream Switcher */
        .stream-switcher {
            display: flex;
            background: rgba(15, 23, 42, 0.6);
            border: 1px solid var(--card-border);
            padding: 4px;
            border-radius: var(--radius-lg);
            margin-bottom: 22px;
        }
        .switcher-tab {
            flex: 1;
            padding: 12px;
            text-align: center;
            border: none;
            background: transparent;
            color: var(--text-secondary);
            font-weight: 800;
            font-size: 0.92rem;
            border-radius: var(--radius-md);
            cursor: pointer;
            transition: all 0.25s ease;
        }
        .switcher-tab.active {
            background: linear-gradient(135deg, var(--primary), #818CF8);
            color: #FFFFFF;
            box-shadow: 0 4px 18px var(--primary-glow);
        }

        /* Subjects Grid */
        .section-header {
            font-size: 1.05rem;
            font-weight: 800;
            margin-bottom: 14px;
        }
        .subjects-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
            gap: 10px;
            margin-bottom: 25px;
        }
        .subject-card {
            background: var(--card-surface);
            border: 1px solid var(--card-border);
            border-radius: var(--radius-lg);
            padding: 14px 6px;
            text-align: center;
            cursor: pointer;
            transition: all 0.25s ease;
            position: relative;
        }
        .subject-card:hover, .subject-card.active {
            transform: translateY(-3px);
            border-color: var(--primary);
            box-shadow: 0 8px 20px -4px var(--primary-glow);
        }
        .subject-card.active::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, var(--primary), var(--accent-pink));
        }
        .subject-emoji {
            font-size: 1.8rem;
            margin-bottom: 4px;
            display: block;
        }
        .subject-card h4 {
            font-size: 0.85rem;
            font-weight: 800;
        }

        /* Materials Grid */
        .materials-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 10px;
            margin-bottom: 35px;
        }
        .material-link-card {
            background: var(--card-surface);
            border: 1px solid var(--card-border);
            border-radius: var(--radius-lg);
            padding: 15px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            text-decoration: none;
            color: var(--text-primary);
            transition: all 0.2s ease;
        }
        .material-link-card:hover {
            border-color: var(--primary);
            transform: translateY(-2px);
        }
        .mat-badge-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
        }

        /* Under Dev Box */
        .under-dev-box {
            background: rgba(239, 68, 68, 0.08);
            border: 1px dashed rgba(239, 68, 68, 0.35);
            border-radius: var(--radius-lg);
            padding: 32px 18px;
            text-align: center;
            color: #FCA5A5;
            margin-bottom: 35px;
        }

        /* Footer */
        footer {
            text-align: center;
            padding: 30px 16px 15px 16px;
            border-top: 1px solid var(--card-border);
            color: var(--text-secondary);
        }

        @media (max-width: 640px) {
            .special-cards-grid, .tele-actions-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
